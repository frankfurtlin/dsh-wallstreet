# 数据源配置
TUSHARE_TOKEN=your_tushare_token_here

# 数据库配置（可选）
DB_TYPE=sqlite
DB_PATH=./data/vectra.db

# 通知配置（可选，用于发送提醒）
# 钉钉机器人
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 企业微信机器人
WECOM_WEBHOOK=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮件通知
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# 监控配置
ENABLE_MONITORING=true
CHECK_INTERVAL=3600  # 每小时检查一次

# 策略参数
GRID_SPREAD=0.10  # 网格交易区间
GRID_COUNT=10     # 网格数量
